# Copia este archivo a .env (pnpm install lo hace solo si no existe).
# Solo valores de desarrollo local: nunca pongas secretos reales aquí.

NODE_ENV=development
LOG_LEVEL=info

# Backend (Fastify). PORT y HOST se respetan para cualquier plataforma de despliegue.
HOST=0.0.0.0
PORT=4000

# PostgreSQL y Redis de infra/docker-compose.yml.
# En producción admiten URLs con TLS (?sslmode=require, rediss://).
DATABASE_URL=postgres://encuanto:encuanto@localhost:5432/encuanto
REDIS_URL=redis://localhost:6379

# Ingesta (H1). FIXTURES_DIR por defecto es <raíz del repo>/fixtures.
SYNC_INTERVAL_MINUTES=360
# Cada cuántos segundos el worker reconcilia los schedulers con los comercios activos (mín. 5).
SCHEDULE_RECONCILE_SECONDS=60
WORKER_CONCURRENCY=2
# Admin mínimo de sync runs: sin ADMIN_TOKEN las rutas /api/admin no existen.
# Genera uno local con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=

# Web (Next.js): URL pública del backend.
NEXT_PUBLIC_API_URL=http://localhost:4000
