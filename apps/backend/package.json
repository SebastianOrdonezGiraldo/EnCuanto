{
  "name": "@encuanto/backend",
  "version": "0.0.0",
  "private": true,
  "description": "API y workers de ¿EnCuánto? (Fastify, monolito modular)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@encuanto/contracts": "workspace:*",
    "@encuanto/db": "workspace:*",
    "fastify": "5.6.2",
    "ioredis": "5.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "pino-pretty": "13.1.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
