{
  "name": "@encuanto/backend",
  "version": "0.0.0",
  "private": true,
  "description": "API y workers de ¿EnCuánto? (Fastify, monolito modular)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "seed": "tsx --env-file-if-exists=../../.env src/dev/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench:search": "tsx --env-file-if-exists=../../.env src/dev/bench-search.ts"
  },
  "dependencies": {
    "@encuanto/contracts": "workspace:*",
    "@encuanto/db": "workspace:*",
    "bullmq": "6.5.4",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.6.2",
    "ioredis": "5.8.2",
    "pino": "10.4.0",
    "saxes": "6.0.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "pino-pretty": "13.1.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
